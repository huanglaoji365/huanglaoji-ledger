# ===== 基础 =====
# 开发环境 dev（验证码打印到控制台并回显在响应里，方便调试）；生产 prod
ENV=dev

# 数据库：开发默认 SQLite；生产 MySQL 示例：
# DATABASE_URL=mysql+pymysql://hlj:password@127.0.0.1:3306/hlj_ledger?charset=utf8mb4
DATABASE_URL=sqlite:///./hlj.db

# ===== JWT =====
# 生产环境务必改成 64+ 位随机字符串：python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-only-secret-change-me
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=14

# ===== SMTP（生产必填；dev 不配置则验证码只打印到控制台）=====
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TLS=true

# ===== 邮件发件人显示名 =====
MAIL_SENDER_NAME=黄老吉记账

# 启动时把该用户名提升为管理员
ADMIN_USERNAME=
